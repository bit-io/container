#[test]
fn build_from_scratch_with_copy_and_metadata() is
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = store::open(dir + "/store", dir + "/run", "vfs")
    util::write_file(dir + "/ctx/app/hello.txt", "hello\n")
    util::write_file(dir + "/ctx/app/sub/deep.txt", "deep\n")
    util::write_file(dir + "/ctx/single.cfg", "k=v\n")
    util::write_file(dir + "/ctx/Containerfile", "FROM scratch\nARG VERSION=7\nENV APP_VERSION=$VERSION\nWORKDIR /srv\nCOPY app/ /srv/app/\nCOPY single.cfg /etc/single.cfg\nLABEL org.example.name=demo\nEXPOSE 8080 53/udp\nVOLUME /data\nUSER 1000:1000\nENTRYPOINT [\"/srv/app/run\"]\nCMD [\"--serve\"]\n")
    let id: string = build::build_image(s, dir + "/ctx", "", "demo:1", [], "none")
    check(string_len(id) == 64, "built")
    same(image::resolve(s, "demo:1"), id, "tagged")
    let cfg: image::ImageConfig = image::config_of(s, id)
    same(util::join(cfg.ic_env, ","), "APP_VERSION=7", "ARG substitution into ENV")
    same(cfg.ic_workdir, "/srv", "workdir")
    same(cfg.ic_user, "1000:1000", "user")
    same(util::join(cfg.ic_entrypoint, " "), "/srv/app/run", "entrypoint")
    same(util::join(cfg.ic_cmd, " "), "--serve", "cmd")
    same(util::join(cfg.ic_ports, ","), "8080/tcp,53/udp", "ports")
    same(util::join(cfg.ic_volumes, ","), "/data", "volumes")
    same(util::join(cfg.ic_labels, ","), "org.example.name=demo", "labels")
    same_int(array_len(cfg.ic_diff_ids), 2, "one layer per COPY")
    let top: string = store::layers_dir(s) + "/" + image::layer_chains(s, id)[1] + "/diff"
    same(util::read_trim(top + "/srv/app/hello.txt"), "hello", "directory contents copied")
    check(util::is_file(top + "/srv/app/sub/deep.txt"), "nested files")
    same(util::read_trim(top + "/etc/single.cfg"), "k=v", "single file")
    util::rm_rf(dir)
end

#[test]
fn build_overrides_arguments() is
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = store::open(dir + "/store", dir + "/run", "vfs")
    util::write_file(dir + "/ctx/Containerfile", "FROM scratch\nARG TARGET=dev\nENV MODE=$TARGET\n")
    let id: string = build::build_image(s, dir + "/ctx", "", "args:1", ["TARGET=prod"], "none")
