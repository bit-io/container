#[test]
fn build_joins_continuations_and_skips_comments() is
    let ls: [string] = build::logical_lines("# comment\nFROM a\n\nRUN one \\\n    two \\\n    three\nCMD [\"x\"]\n")
    same_int(array_len(ls), 3, "three instructions")
    same(ls[0], "FROM a", "from")
    same(ls[1], "RUN one two three", "joined")
    same(build::instruction_of("run echo hi"), "RUN", "case-insensitive")
    same(build::arguments_of("RUN echo   hi"), "echo   hi", "arguments")
end

#[test]
fn build_expands_variables() is
    let vars: [string] = ["NAME=world", "VER=1.2"]
    same(build::substitute("hello $NAME", vars), "hello world", "plain")
    same(build::substitute("v${{VER}}-x", vars), "v1.2-x", "braces")
    same(build::substitute("$MISSING|", vars), "|", "unknown is empty")
    same(build::substitute("cost \\$5 and $", vars), "cost $5 and $", "escaped and lone dollar")
end

#[test]
fn build_parses_key_values_and_exec_forms() is
    let kv: [string] = build::key_values("A=1 B=\"two words\" C='x y'")
    same_int(array_len(kv), 3, "three pairs")
    same(kv[1], "B=two words", "double quotes")
    same(kv[2], "C=x y", "single quotes")
    same(build::key_values("LEGACY some value")[0], "LEGACY=some value", "legacy form")
    same(util::join(build::exec_or_shell("[\"/bin/app\", \"-v\"]"), "|"), "/bin/app|-v", "exec form")
    same(util::join(build::exec_or_shell("echo hi"), "|"), "/bin/sh|-c|echo hi", "shell form")
end

