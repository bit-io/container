#[test]
fn build_rejects_unsupported_and_broken_files() is
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = store::open(dir + "/store", dir + "/run", "vfs")
    util::write_file(dir + "/a/Containerfile", "RUN echo no from\n")
    same(build::build_image(s, dir + "/a", "", "x:1", [], "none"), "", "FROM must come first")
    util::write_file(dir + "/b/Containerfile", "FROM scratch\nFROM scratch\n")
    same(build::build_image(s, dir + "/b", "", "x:1", [], "none"), "", "multi-stage")
    util::write_file(dir + "/c/Containerfile", "FROM scratch\nCOPY missing.txt /x\n")
    same(build::build_image(s, dir + "/c", "", "x:1", [], "none"), "", "missing source")
    util::write_file(dir + "/d/Containerfile", "FROM scratch\nFROBNICATE now\n")
    same(build::build_image(s, dir + "/d", "", "x:1", [], "none"), "", "unknown instruction")
    util::write_file(dir + "/e/Containerfile", "FROM scratch\nCOPY ../secret /x\n")
    same(build::build_image(s, dir + "/e", "", "x:1", [], "none"), "", "no escaping the context")
    same(build::build_image(s, dir + "/nothing", "", "x:1", [], "none"), "", "no Containerfile")
    same_int(array_len(image::image_ids(s)), 0, "failed builds register nothing")
    util::rm_rf(dir)
end

#[test]
fn build_runs_commands_and_records_changes_as_layers() is
    if !can_run() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = base_store(dir)
    util::write_file(dir + "/ctx/src/hello.txt", "hello\n")
    util::write_file(dir + "/ctx/Containerfile", "FROM mini:1\nARG GREETING=hi\nENV MSG=$GREETING-world\nWORKDIR /app\nCOPY src/ /app/\nRUN echo $MSG > /app/msg && rm /etc/group && mkdir -p /var/data && echo made > /var/data/f\nRUN true\nCMD [\"/bin/cat\", \"/app/msg\"]\n")
    let id: string = build::build_image(s, dir + "/ctx", "", "built:1", [], "host")
    check(id != "", "built")
    let cfg: image::ImageConfig = image::config_of(s, id)
    same_int(array_len(cfg.ic_diff_ids), 3, "base + COPY + RUN (the no-op RUN adds no layer)")
    same_int(array_len(cfg.ic_history), 7, "history keeps every step")
    let top: string = store::layers_dir(s) + "/" + image::layer_chains(s, id)[2] + "/diff"
    same(util::read_trim(top + "/app/msg"), "hi-world", "RUN saw the ENV/ARG values")
    check(!util::exists(top + "/etc/group"), "deleted file is gone in the flattened layer")
    same(util::read_trim(top + "/var/data/f"), "made", "new directory content")
    check(util::exists(top + "/app/hello.txt"), "COPY content still there")
    check(!util::exists(top + "/.po"), "no pivot leftovers in the image")
    let mut o: runtime::Options = runtime::options("built:1")
    o = runtime::opt(o, "network", "host")
    o = runtime::opt(o, "detach", "true")
    let c: string = runtime::create(s, o)
    runtime::start(s, c, false)
    same_int(runtime::wait(s, c, 20000), 0, "built image runs")
    check(string_contains(runtime::logs(s, c), "hi-world"), "CMD output: " + runtime::logs(s, c))
    runtime::remove(s, c, true)
    let mut base_only: runtime::Options = runtime::options("mini:1")
    base_only = runtime::opt(base_only, "network", "host")
    base_only = runtime::opt(base_only, "detach", "true")
    base_only = runtime::opt_add(base_only, "arg", "/bin/ls")
    base_only = runtime::opt_add(base_only, "arg", "/etc")
    let b: string = runtime::create(s, base_only)
    runtime::start(s, b, false)
    runtime::wait(s, b, 20000)
    check(string_contains(runtime::logs(s, b), "group"), "the base image still has /etc/group")
    util::rm_rf(dir)
end

#[test]
fn build_whiteouts_survive_export_and_import() is
    if !can_run() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = base_store(dir)
    util::write_file(dir + "/ctx/Containerfile", "FROM mini:1\nRUN rm /etc/group\n")
    let id: string = build::build_image(s, dir + "/ctx", "", "wh:1", [], "none")
    check(id != "", "built")
    check(image::export_layout(s, "wh:1", dir + "/oci"), "export")
    let other: store::Store = store::open(dir + "/store2", dir + "/run2", "vfs")
    same(image::import_layout(other, dir + "/oci", ""), id, "same id after the round trip")
    let top: string = store::layers_dir(other) + "/" + image::layer_chains(other, id)[1] + "/diff"
    check(!util::exists(top + "/etc/group"), "the OCI .wh. marker was applied on import")
    check(util::is_file(top + "/etc/passwd"), "other files survive")
    util::rm_rf(dir)
end

#[test]
fn build_fails_when_a_run_step_fails() is
    if !can_run() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = base_store(dir)
    util::write_file(dir + "/ctx/Containerfile", "FROM mini:1\nRUN exit 3\nCMD [\"/bin/true\"]\n")
    same(build::build_image(s, dir + "/ctx", "", "bad:1", [], "none"), "", "failing RUN aborts the build")
    check(!image::exists(s, "bad:1"), "nothing tagged")
    util::rm_rf(dir)
end
