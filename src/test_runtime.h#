#[test]
fn runtime_runs_a_command_in_fresh_namespaces() is
    if !can_run() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = setup(dir, "vfs")
    util::mkdir_p(dir + "/out")
    let mut o: runtime::Options = host_opts(["/bin/sh", "-c", "echo hello from $(hostname); echo $$ > /out/pid; ls / > /out/rootls; id -u > /out/uid"])
    o = runtime::opt(o, "hostname", "boxed")
    o = runtime::opt_add(o, "volume", dir + "/out:/out")
    let id: string = runtime::create(s, o)
    check(id != "", "created")
    same_int(runtime::start(s, id, false), 0, "started")
    same_int(runtime::wait(s, id, 20000), 0, "exit code")
    same(runtime::status(s, id), "exited", "status")
    check(string_contains(runtime::logs(s, id), "hello from boxed"), "own hostname: " + runtime::logs(s, id))
    same(util::read_trim(dir + "/out/pid"), "1", "pid 1 in its own pid namespace")
    same(util::read_trim(dir + "/out/uid"), "0", "root inside")
    let rootls: string = util::read(dir + "/out/rootls")
    check(!string_contains(rootls, "home") && !string_contains(rootls, "var"), "sees only its own root: " + rootls)
    check(util::capture("hostname") != "boxed", "host hostname untouched")
    check(runtime::remove(s, id, false), "removed")
    util::rm_rf(dir)
end

