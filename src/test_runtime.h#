#[test]
fn runtime_cgroup_limits_are_applied() is
    if !can_run() || !cgroup::available() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = setup(dir, "vfs")
    let mut o: runtime::Options = host_opts(["/bin/sleep", "300"])
    o = runtime::opt(o, "pids", "33")
    o = runtime::opt(o, "memory", "128m")
    let id: string = runtime::create(s, o)
    runtime::start(s, id, false)
    check(cgroup::exists(id), "group exists")
    let ds: [string] = cgroup::dirs(id)
    let mut found_pids: bool = false
    let mut i: int = 0
    while i < array_len(ds) is
        if util::read_trim(ds[i] + "/pids.max") == "33" is found_pids = true end
        i += 1
    end
    check(found_pids, "pids.max is 33")
    check(array_len(cgroup::procs(id)) > 0, "container processes are in the group")
    runtime::stop(s, id, 1)
    check(runtime::remove(s, id, false), "remove")
    check(!cgroup::exists(id), "group removed with the container")
    util::rm_rf(dir)
end

