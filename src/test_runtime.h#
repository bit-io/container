    o = runtime::opt_add(o, "arg", "/bin/sh")
    o = runtime::opt_add(o, "arg", "-c")
    o = runtime::opt_add(o, "arg", "exit 4")
    same_int(runtime::run_container(s, o), 4, "exit code")
    same_int(array_len(runtime::ids(s)), 0, "container removed (--rm)")
    util::rm_rf(dir)
end
