#[test]
fn network_plans_and_parses_ports() is
    let pm: network::PortMap = network::parse_publish("127.0.0.1:8080:80/udp")
    check(pm.pm_ok, "ok")
    same(pm.pm_host_ip, "127.0.0.1", "ip")
    same_int(pm.pm_host_port, 8080, "host port")
    same_int(pm.pm_ctr_port, 80, "container port")
    same(pm.pm_proto, "udp", "proto")
    check(!network::parse_publish("80").pm_ok, "needs host:container")
    check(!network::parse_publish("a:b").pm_ok, "numbers only")
    let id: string = string_repeat("ab", 32)
    let plan: [string] = network::plan_setup(id, 4242, "10.88.0.7", ["8080:80"])
    check(string_contains(util::join(plan, "\n"), "ip link set vcabababab netns 4242"), "moves the peer")
    check(string_contains(util::join(plan, "\n"), "--to-destination 10.88.0.7:80"), "dnat")
    check(string_contains(util::join(plan, "\n"), "MASQUERADE"), "nat")
    let down: [string] = network::plan_teardown(id, "10.88.0.7", ["8080:80"])
    check(string_contains(util::join(down, "\n"), "-D PREROUTING"), "removes dnat")
    check(string_contains(util::join(down, "\n"), "ip link del vhabababab"), "removes veth")
    check(string_contains(network::hosts_file("10.88.0.7", "box"), "10.88.0.7\tbox"), "hosts")
    check(string_contains(network::resolv_conf(), "nameserver"), "resolv.conf has a nameserver")
end

