    r = runtime::opt(r, "readonly", "true")
    r = runtime::opt_add(r, "volume", dir + "/out:/out")
    let id2: string = runtime::create(s, r)
    runtime::start(s, id2, false)
    runtime::wait(s, id2, 20000)
    check(!string_contains(util::read(dir + "/out/ro"), "rc=0"), "read-only rootfs: " + util::read(dir + "/out/ro"))
