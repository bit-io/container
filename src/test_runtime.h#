#[test]
fn runtime_mounts_volumes_and_honours_readonly() is
    if !can_run() is return end
    let dir: string = util::capture("mktemp -d")
    let s: store::Store = setup(dir, "vfs")
    util::write_file(dir + "/data/in.txt", "from host\n")
    util::mkdir_p(dir + "/out")
