#[test]
fn spec_resolves_users_and_adjusts_capabilities() is
    let dir: string = util::capture("mktemp -d")
    util::write_file(dir + "/etc/passwd", "root:x:0:0::/root:/bin/sh\napp:x:1000:1001::/home/app:/bin/sh\n")
    util::write_file(dir + "/etc/group", "root:x:0:\nstaff:x:50:\n")
    same(spec::resolve_user(dir, "app"), "1000:1001", "name -> uid:gid")
    same(spec::resolve_user(dir, "app:staff"), "1000:50", "name:group")
    same(spec::resolve_user(dir, "1000"), "1000:1001", "numeric uid finds its gid")
    same(spec::resolve_user(dir, "42:7"), "42:7", "numeric pair unchanged")
    same(spec::resolve_user(dir, "ghost"), "ghost", "unknown stays")
    same(spec::resolve_user(dir, ""), "0:0", "default root")
    let caps: [string] = spec::adjust_caps(spec::default_caps(), ["net_admin"], ["CAP_MKNOD", "chown"])
    check(util::has(caps, "CAP_NET_ADMIN"), "added")
    check(!util::has(caps, "CAP_MKNOD") && !util::has(caps, "CAP_CHOWN"), "dropped")
    same_int(array_len(spec::adjust_caps(spec::default_caps(), [], ["all"])), 0, "drop all")
    same(spec::cap_short("CAP_NET_RAW"), "net_raw", "short")
    util::rm_rf(dir)
end

