[package]
-> name        => ctr
-> version     => 0.1.0
-> description => A small docker-like command line built on the container library
-> authors     => ["Bit Developers"]
-> license     => Apache-2.0
-> lang        => h#

[edition]
-> edition => 2026

[build]
-> link => static

[default-build]
-> profile => release

[dependencies]
-> container => path ../..
